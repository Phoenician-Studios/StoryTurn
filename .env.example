# App
NEXT_PUBLIC_APP_URL=http://localhost:3456
FORCE_DEMO_MODE=1

# Google Books (optional) — ISBN/barcode + title search prefer Google when set.
# If unset, lookups fall back to Open Library only.
GOOGLE_BOOKS_API_KEY=

# Supabase (Auth + Postgres) — leave unset to use built-in demo mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Plunk email (ICS invites)
PLUNK_API_KEY=

# Upstash QStash (session generation cron)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=dev-cron-secret
