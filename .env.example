# App
# Local dev. Production on Vercel is https://www.storyturn.app
# (storyturn.app redirects there).
NEXT_PUBLIC_APP_URL=http://localhost:3456
FORCE_DEMO_MODE=1

# Supabase (Auth + Postgres) — leave unset to use built-in demo mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Plunk email (ICS invites)
PLUNK_API_KEY=

# Upstash QStash (session generation cron)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=dev-cron-secret

# Optional real contact address for Open Library request identification
# Requests remain conservatively paced at one per 1.1 seconds.
OPEN_LIBRARY_CONTACT=
